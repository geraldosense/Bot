{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "env": {
    "VITE_SIGNAL_MODE": "poll"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 10 },
    "api/health.js": { "maxDuration": 10 },
    "api/auth/login.js": { "maxDuration": 10 },
    "api/auth/me.js": { "maxDuration": 10 },
    "api/auth/register.js": { "maxDuration": 10 },
    "api/auth/presence.js": { "maxDuration": 10 },
    "api/snapshot.js": { "maxDuration": 10 },
    "api/signals.js": { "maxDuration": 10 },
    "api/scoreboard.js": { "maxDuration": 10 },
    "api/analyze.js": { "maxDuration": 10 }
  }
}
