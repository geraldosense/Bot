# Copia para .env local (nunca commits este ficheiro com valores reais)
PORT=3001
NODE_ENV=development

# Obrigatório em produção — usa uma string longa e aleatória
JWT_SECRET=muda-isto-para-uma-chave-secreta-longa

# Chef Máximo (criado automaticamente no primeiro arranque se não existir)
SUPER_ADMIN_EMAIL=teu@email.com
SUPER_ADMIN_PASSWORD=tua_password_segura
SUPER_ADMIN_NAME=Sense Oliveira

# Casino Evolution (opcional — sinais ao vivo)
SUPABASE_URL=
SUPABASE_KEY=
BACBO_GAME_ID=bac_bo
