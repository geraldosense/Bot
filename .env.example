# Copia para .env local (nunca commits este ficheiro com valores reais)
PORT=3001
NODE_ENV=development

# Obrigatório em produção — usa uma string longa e aleatória
JWT_SECRET=muda-isto-para-uma-chave-secreta-longa

# Proprietário (criado automaticamente no primeiro arranque se não existir)
SUPER_ADMIN_EMAIL=teu@email.com
SUPER_ADMIN_PASSWORD=tua_password_segura
SUPER_ADMIN_NAME=Sense Oliveira

# Base de dados persistente (contas — obrigatório em produção)
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_URL=https://btyescbddoopbbuacyhd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mesa Evolution Bac Bo (dados ao vivo — projecto separado das contas)
CASINO_SUPABASE_URL=https://btyescbddoopbbuacyhd.supabase.co
SUPABASE_KEY=
BACBO_GAME_ID=bac_bo
