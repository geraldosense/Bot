{
  "name": "bac-bo-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "node server/index.js",
    "live": "npm run build && node server/index.js",
    "go-live": "node scripts/go-live.mjs",
    "go-live:dev": "node scripts/go-live-dev.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:setup": "node scripts/setup-supabase.mjs",
    "db:import": "node scripts/import-users.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^11.18.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
